// wasp db migrate-dev
// wasp db studio

datasource db {
  provider = "sqlite"
  // Wasp requires that the url is set to the DATABASE_URL environment variable.
  url      = env("DATABASE_URL")
}

// Wasp requires the `prisma-client-js` generator to be present.
generator client {
  provider = "prisma-client-js"
}

model Game {
  id            Int      @id @default(autoincrement())
  activeGame    Boolean  @default(false)
  sourceDeck    Deck     @relation("SourceDeck", fields: [sourceDeckId], references: [id])
  sourceDeckId  Int      @unique 
  drawDeck      Deck     @relation("DrawDeck", fields: [drawDeckId], references: [id])
  drawDeckId    Int      @unique 
  discardDeck   Deck     @relation("DiscardDeck", fields: [discardDeckId], references: [id])
  discardDeckId Int      @unique 
  players       Player[] @relation("GamePlayers")
}

model Card {
  id       Int     @id @default(autoincrement())
  suit     String
  value    String
  score    Int
  deck     Deck?   @relation("DeckCards", fields: [deckId], references: [id])
  deckId   Int?    
  deckOrder Int? 
}

model Deck {
  id             Int    @id @default(autoincrement())
  name           String
  cards          Card[] @relation("DeckCards")
  sourceDeckGame Game?  @relation("SourceDeck")
  drawDeckGame   Game?  @relation("DrawDeck")
  discardDeckGame Game? @relation("DiscardDeck")
}

model Player {
  id     Int    @id @default(autoincrement())
  name   String
  bet    Int
  money  Int
  game   Game   @relation("GamePlayers", fields: [gameId], references: [id])
  gameId Int
}